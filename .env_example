# Copy this file to `.env` and adjust paths. Relative paths are resolved from the project root.
#
# Data download target (CSV files). Used by: get_stock_data.py, train --csv_dir, run_protocol, interactive menu.
SAVE_DIR=historical_data
#
# Backtest / predict outputs and comparison_summary.csv. Used by: backtest_stock.py, predict_stock.py, run_protocol.py, Results menu.
RESULTS_DIR=backtest_results
#
# Trained model artifacts (per-symbol subfolders). Used by: train_stock.py, backtest, menu model picker.
MODEL_DIR=model
